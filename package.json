{
  "name": "valle-interior",
  "version": "0.2.0",
  "description": "Valle Interior: sitio personal con biblioteca de mangas traducidos, salas, grupos de lectura y panel admin.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/migrate.js",
    "create-admin": "node server/scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "build:artifact": "node tools/build-artifact.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  }
}
