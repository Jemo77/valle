# --- Obligatorias ---
POSTGRES_PASSWORD=cambia-esto-por-algo-largo
ADMIN_USERNAME=tu-usuario
# Mínimo 8 caracteres. Solo se usa para crear la cuenta de administración la primera vez.
ADMIN_PASSWORD=cambia-esto-tambien

# --- Recomendadas en producción ---
# La dirección pública con https. Activa cookies seguras y la verificación de origen.
PUBLIC_ORIGIN=https://valle.tudominio.com
# true si hay un proxy delante (Caddy, Nginx, Cloudflare, Render, Railway...)
TRUST_PROXY=true

# --- Opcionales ---
ALLOW_REGISTRATION=true
PORT=3000
# SESSION_DAYS=30
# Solo para desarrollo sin Docker:
# DATABASE_URL=postgres://valle:valle@localhost:5432/valle
# UPLOAD_DIR=./uploads
